---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeritageBackground from '../components/HeritageBackground.astro';
import { studioSources } from '../lib/studio';

const portraitPhoto = studioSources('IMG_6235');
const secondaryPhoto = studioSources('IMG_6681');
---
<BaseLayout title="about | kaloyan dimitrov" description="kaloyan dimitrov is a composer, sound designer and mix engineer working across film, television and advertising.">
  <HeritageBackground />
  <Header hero current="about" />
  <main id="main">
    <section class="block">
      <div id="about">
        <div class="portrait">
          <picture>
            <source type="image/avif" srcset={portraitPhoto.avif} sizes="(max-width: 760px) 100vw, 340px" />
            <img src={portraitPhoto.src} srcset={portraitPhoto.webp} sizes="(max-width: 760px) 100vw, 340px" alt="window into kaloyan's live room" width={portraitPhoto.width} height={portraitPhoto.height} loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="bio">
          <div class="eyebrow">about</div>
          <p>kaloyan dimitrov is a composer, sound designer and mix engineer working across film, television and advertising. from sundance-selected features to full network rebrands, his work lives where picture ends and feeling begins.</p>
          <p>two decades of cues for audi, pepsi, nestlé, societe generale, btv and the films of miramar — composed, designed and mixed in sofia, heard everywhere.</p>
          <div class="disciplines"><span>music</span><span>mix</span><span>sound design</span></div>
        </div>
      </div>
      <div class="about-secondary">
        <picture>
          <source type="image/avif" srcset={secondaryPhoto.avif} sizes="(max-width: 760px) 100vw, 800px" />
          <img src={secondaryPhoto.src} srcset={secondaryPhoto.webp} sizes="(max-width: 760px) 100vw, 800px" alt="rhodes and keys in the studio" width={secondaryPhoto.width} height={secondaryPhoto.height} loading="lazy" decoding="async" />
        </picture>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
