---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeritageBackground from '../components/HeritageBackground.astro';
import { studioSources } from '../lib/studio';

const silencePhoto = studioSources('IMG_6236');
import { withBase } from '../lib/url';
---
<BaseLayout title="silence. | kaloyan dimitrov" description="404 — this page doesn't exist.">
  <HeritageBackground />
  <main id="main" class="silence">
    <picture>
      <source type="image/avif" srcset={silencePhoto.avif} sizes="100vw" />
      <img class="silence-photo" src={silencePhoto.src} srcset={silencePhoto.webp} sizes="100vw" alt="" width={silencePhoto.width} height={silencePhoto.height} loading="lazy" decoding="async" />
    </picture>
    <div class="eyebrow">404</div>
    <h1>silence.</h1>
    <div class="flatline" aria-hidden="true"></div>
    <p>this cue doesn&rsquo;t exist — the signal just goes flat here.</p>
    <a href={withBase('/work')}>back to work</a>
  </main>
</BaseLayout>
