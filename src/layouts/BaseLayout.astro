---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Pages with the opener island start with header/main hidden and reveal
   *  via body.ready once the opener finishes (spec §6). Every other page
   *  renders body.ready immediately server-side so nothing ever depends on
   *  JS to become visible. */
  hasOpener?: boolean;
  /** og:image — defaults to the site's general share image; project pages
   *  pass their poster (spec §13: "poster as og:image"). */
  image?: string;
  /** og:type — project pages pass "video.other". */
  ogType?: string;
  /** Pages with YouTube embeds (background loops and/or the detail player)
   *  pass this so the browser opens connections to YouTube's origins during
   *  HTML parsing instead of only once the video-layer script runs and an
   *  iframe's src is actually set — shaves the connection setup + iframe_api
   *  script fetch off the time-to-first-frame for the first video. */
  hasVideo?: boolean;
}
const {
  title,
  description = 'kaloyan dimitrov — music + sound post. composer, sound designer, mix engineer.',
  hasOpener = false,
  // CR-003 — points at the generated 1280px fallback (scripts/optimize-posters.mjs);
  // the pre-optimization path this used to be no longer exists.
  image = '/posters/opt/viktoria-trailer-2-1280.jpg',
  ogType = 'website',
  hasVideo = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(withBase(image), Astro.site);

/** Every build is noindex unless it explicitly opts in via INDEXABLE=true
 *  (see astro.config.mjs). Defaulting to noindex means a forgotten flag
 *  hides a finished site rather than exposing an unfinished one.
 *
 *  This is deliberately NOT derived from the base path. An earlier version
 *  tied the two together, which would have silently un-noindexed the
 *  Cloudflare client preview the moment it was built to serve at the root —
 *  "where is it served" and "is it ready to be found" are different questions.
 *
 *  robots.txt is NOT an option here: it is only honoured at the domain root,
 *  and the cPanel build deploys under /new, so kalodimitrov.com/new/robots.txt
 *  would be ignored by crawlers. A meta tag works at any path. */
const indexable: boolean = import.meta.env.SITE_INDEXABLE === true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href={withBase('/favicon.svg')} />

  {hasVideo && (
    <>
      <link rel="preconnect" href="https://www.youtube.com" />
      <link rel="dns-prefetch" href="https://www.youtube.com" />
      <link rel="preconnect" href="https://i.ytimg.com" />
      <link rel="dns-prefetch" href="https://i.ytimg.com" />
      <link rel="preload" as="script" href="https://www.youtube.com/iframe_api" />
    </>
  )}

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="kaloyan dimitrov" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Kaloyan Dimitrov',
    jobTitle: 'Composer, Sound Designer, Mix Engineer',
    description: 'Composer, sound designer and mix engineer working across film, television and advertising.',
    url: 'https://kalodimitrov.com',
    knowsAbout: ['Music Composition', 'Sound Design', 'Audio Mixing'],
  })} is:inline />
</head>
<body class={hasOpener ? undefined : 'ready'}>
  <a class="skip-link" href="#main">skip to content</a>
  <slot />
</body>
</html>
