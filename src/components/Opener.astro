---
import { studioSources } from '../lib/studio';

// CR-003 — pre-generated offline (scripts/optimize-studio.mjs) rather than
// through astro:assets, which segfaults libvips on the cPanel host. Still a
// plain <img> so the preload below can reference the exact same URL — the LCP
// element (CR-2) must be preloaded, and that only works if both tags agree.
const openerPhoto = studioSources('IMG_9569');
---

<link rel="preload" as="image" href={openerPhoto.src} fetchpriority="high" />
<div id="opener">
  <img
    id="openerPhoto"
    class="opener-photo"
    src={openerPhoto.src}
    width={openerPhoto.width}
    height={openerPhoto.height}
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <canvas id="fx" aria-hidden="true"></canvas>
  <div id="choice" role="dialog" aria-label="sound preference">
    <div id="openerWordmark" class="opener-wordmark">kaloyan dimitrov</div>
    <div class="sub">sound design · original music · mix creative</div>
    <div class="prompt">this site is meant to be heard</div>
    <div class="buttons">
      <button class="enter primary" id="withSound" type="button">enter with sound</button>
      <button class="enter" id="withoutSound" type="button">enter quietly</button>
    </div>
  </div>
  <div id="skipnote">tap anywhere to skip</div>
</div>

<script>
  /* CR-003 — the opener is build-flagged off by default. This guard is NOT
     belt-and-braces for the `{showOpener && <Opener />}` check in index.astro:
     Astro hoists a component's script into the page bundle based on the static
     import, not on whether the component actually rendered, so without this the
     whole engine (canvas, Web Audio cue, timeline, colors — ~12KB) shipped to
     every visitor as dead code. SITE_OPENER is a build-time literal, so when it
     is false Rollup eliminates this branch and the dynamic import with it. */
  if (import.meta.env.SITE_OPENER === true) {
    const { initOpener } = await import('../scripts/opener/index');
    initOpener();
  }
</script>
